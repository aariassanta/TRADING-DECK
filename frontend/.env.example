# Backend URL. Leave empty for same-origin (recommended with FastAPI
# StaticFiles mount on the same host as the SPA — works for LAN access
# from another machine on the same network).
#
# Set this only if the SPA is served from a different host than the
# FastAPI backend (e.g. behind a reverse proxy on a different port).
# VITE_BACKEND_URL=http://192.168.1.50:8000